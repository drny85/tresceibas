# ── Next.js (.env.local) ──────────────────────────────────────────
# Filled in automatically by `bunx convex dev`
NEXT_PUBLIC_CONVEX_URL=
# Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: shows the PayPal option on the donate page (same client id as below)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ── Convex (set with `bunx convex env set NAME value`, not in this file) ──
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# ADMIN_EMAILS=robert@example.com,committee@example.com
# SITE_URL=https://tresceibas.org
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_API_BASE=https://api-m.paypal.com   # default is the sandbox
